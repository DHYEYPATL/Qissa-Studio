# ========================================
# Qissa Studio - Environment Configuration
# ========================================
#
# Copy this file to .env and fill in your actual API keys
# NEVER commit your .env file to Git!
#
# Get your API keys from:
# - Gemini: https://aistudio.google.com/app/apikey
# - Parallel: https://platform.parallel.ai
#

# ===== GEMINI API (Required for AI script generation) =====
# Get your key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Use Vertex AI instead of Google AI Studio
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# Gemini model to use (recommended: gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-2.0-flash-exp

# ===== PARALLEL SEARCH API (Required for trend scouting) =====
# Get your key from Parallel AI Platform
PARALLEL_API_KEY=your_parallel_api_key_here
PARALLEL_SEARCH_MODE=fast

# ===== APPLICATION SETTINGS =====
PORT=8080
